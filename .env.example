# ──────────────────────────────────────────────────────────────────────────────
# KinSync environment variables
#
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set before the app will start.
# Variables marked [OPTIONAL] have sensible defaults shown below.
# Variables marked [3RD PARTY] require an external account.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string.
# Local default (matches docker-compose.yml):
DATABASE_URL="postgresql://kinsync:kinsync@localhost:5432/kinsync"

# ── Auth ──────────────────────────────────────────────────────────────────────
# [REQUIRED] Secret used to sign JWTs. Must be at least 32 random characters.
# Generate with: openssl rand -base64 32
JWT_SECRET=""

# ── App URLs ──────────────────────────────────────────────────────────────────
# [OPTIONAL] Public URL of the web app (used for magic-link generation).
WEB_URL="http://localhost:3000"

# [OPTIONAL] Public URL of the API.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# [REQUIRED] SMTP host.
# Local default (matches docker-compose.yml MailHog):
SMTP_HOST="localhost"

# [OPTIONAL] SMTP port. Runtime default is 587. The example value 1025 is for local MailHog usage.
SMTP_PORT="1025"

# [OPTIONAL] SMTP credentials (not required for MailHog).
SMTP_USER=""
SMTP_PASS=""

# [OPTIONAL] From address used in outgoing emails.
EMAIL_FROM="KinSync <noreply@kinsync.app>"

# ── Stripe (Billing) ──────────────────────────────────────────────────────────
# [3RD PARTY] Stripe secret API key.
# Obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""

# [3RD PARTY] Stripe publishable key (used in the frontend).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# [3RD PARTY] Stripe webhook signing secret.
# Obtain from https://dashboard.stripe.com/webhooks or via:
#   stripe listen --forward-to localhost:3001/api/billing/webhook
STRIPE_WEBHOOK_SECRET=""

# [3RD PARTY] Stripe Price ID for the default subscription plan.
NEXT_PUBLIC_STRIPE_PRICE_ID=""

# ── Node environment ──────────────────────────────────────────────────────────
# [OPTIONAL] Defaults to "development".
NODE_ENV="development"